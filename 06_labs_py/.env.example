# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Required for labs 02-05 — selects and configures the LLM provider via
# ai_client.py. AI_PROVIDER must be one of: claude | gemini | openai | azure | ollama
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite
AI_API_KEY=your-provider-api-key-here

# Only needed for AI_PROVIDER=azure (endpoint URL + API version) or
# AI_PROVIDER=ollama (base URL, defaults to http://localhost:11434/v1 if unset).
# AI_BASE_URL=
# AI_API_VERSION=2024-10-21

# Required for 01_naive_rag.ipynb only — HuggingFace Hub token (used for
# huggingfacehub_api_token). Get one at https://huggingface.co/settings/tokens
# Unrelated to AI_PROVIDER above; lab 01 always uses HuggingFace directly.
HF_TOKEN=hf_your-token-here
